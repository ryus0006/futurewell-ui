# See http://help.github.com/ignore-files/ for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc

# Node
/node_modules
npm-debug.log
yarn-error.log

# Vite / Vitest
/.vite
/coverage
*.tsbuildinfo

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Working notes, kept local
PLAN.md

# Automated tests, kept local
*.test.ts
*.test.tsx
/src/test/

# Mock backend, kept local. `dev-setup.ts` starts it and `vite.config.local.ts`
# is the only thing that loads it, so no tracked file refers to any of this and
# the app still builds from a clean clone:
#   npx vite --config vite.config.local.ts
/src/core/api/mock/
/src/dev-setup.ts
/vite.config.local.ts
/public/mockServiceWorker.js

# Miscellaneous
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db
