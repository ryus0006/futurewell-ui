  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "(.*?)" },
          "endsPattern": { "regexp": "ready in|Local:" }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "problemMatcher": ["$tsc"]
    }
  ]
}
